# Never commit .env. Default commands do not load models.
MODEL_API_KEY=
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_API_KEY=
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_MODEL=gemini-3.5-flash-lite
JUDGE_VERIFIED_FREE=false
JUDGE_MAX_CALLS=100
JUDGE_MAX_TOKENS=512
# Blank selects documented low effort only for the exact Google Gemini endpoint.
JUDGE_REASONING_EFFORT=
DATABASE_URL=sqlite:///aster.db
ASTER_RATE_SALT=replace-with-a-random-secret
ASTER_CALLER_JUDGE_LIMIT=30
ASTER_GLOBAL_JUDGE_LIMIT=100
